# AgentDock backend configuration. Copy to backend/.env and fill in.
# .env is gitignored — never commit real values.

# --- Database ---
MONGO_URL="mongodb://localhost:27017"
DB_NAME="agentdock"

# --- CORS: the exact origin(s) the browser loads the frontend from ---
CORS_ORIGINS="http://localhost:3100"

# --- BNB Smart Chain (mainnet, chain 56) ---
BSC_CHAIN_ID="56"
# A private BNB mainnet RPC (Alchemy/QuickNode/Ankr). The public data-seed nodes
# work but are slow and rate-limited.
BSC_RPC_URL=""
ERC8004_IDENTITY_REGISTRY="0x8004A169FB4a3325136EB29fA0ceB6D2e539a432"

# --- 8004scan API ---
# The key must be present as a variable even if empty; the client reads it
# unconditionally. Send it as a bearer token (the client does this). A Pro key
# lifts limits to 3000/min on the non-public route.
SCAN8004_BASE_URL="https://8004scan.io/api/v1/public"
SCAN8004_API_KEY=""
SCAN8004_CHAIN_ID="56"

# --- Optional integrations (left blank keeps them disabled and honestly locked) ---
# Binance B402 merchant onboarding (AgentDock as a merchant; buyer-side b402
# needs none of these).
B402_BASE_URL=""
B402_CLIENT_ID=""
B402_ACCESS_TOKEN=""
B402_RSA_PRIVATE_KEY_PATH=""
# S3-compatible object storage for result artifacts (MongoDB fallback otherwise).
S3_ENDPOINT_URL=""
S3_REGION=""
S3_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Operator secret gating the maintenance endpoints (/b402/sync,
# /onchain/sync-all, /onchain/enrich-endpoints). Unset means those endpoints
# refuse every caller, which is the safe default for a public deployment.
ADMIN_TOKEN=""
# Per-caller ceilings per minute; defaults shown.
RATE_LIMIT_TASKS="20"
RATE_LIMIT_RUNS="30"
