# AgentDock frontend configuration. Copy to frontend/.env and fill in.
# These are read by Create React App at BUILD time and baked into the bundle —
# a public deployment must rebuild after changing them. Nothing secret belongs
# here: everything shipped to the browser is public.

# The public address of the backend API.
REACT_APP_BACKEND_URL=http://localhost:8000

# BNB Chain RPCs used by the wallet for contract reads (register/edit metadata).
REACT_APP_BSC_RPC_URL=https://data-seed-prebsc-1-s1.bnbchain.org:8545
REACT_APP_BSC_MAINNET_RPC_URL=https://bsc-dataseed.bnbchain.org

REACT_APP_BINANCE_WALLET_URL=https://www.binance.com/en/web3wallet
REACT_APP_ERC8004_MAINNET_REGISTRY=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
REACT_APP_ERC8004_TESTNET_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
REACT_APP_8004SCAN_URL=https://8004scan.io

# Local dev server: keep the app on 3100 to match CORS_ORIGINS.
PORT=3100
WDS_SOCKET_PORT=3100
